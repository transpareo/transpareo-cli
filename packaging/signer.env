# Settings of the Transpareo signing endpoint. systemd passes
# them to the service, which reads a setting it was not given as
# an option from the environment. A package upgrade keeps this
# file as you edited it.

# Public key of the platform host that signs for the workspace.
# Take the workspace host from the address bar of the application
# manager, for example acme.transpareo.com.
TRANSPAREO_PLATFORM_KEY=https://acme.transpareo.com/.well-known/transpareo-signing-key.pem

# The host name registered in the BYOK form. nginx replaces the
# Host header on the way in, so the signer needs to know it.
TRANSPAREO_SIGNER_HOST=signer.example.com

# Loopback only; nginx terminates TLS in front of it.
TRANSPAREO_SIGNER_LISTEN=127.0.0.1:8443
