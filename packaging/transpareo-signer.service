[Unit]
Description=Transpareo BYOK signing endpoint
Documentation=https://github.com/transpareo/transpareo-cli/blob/main/docs/signer-ubuntu.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transpareo-signer
Group=transpareo-signer
# The tool looks for its configuration under the home directory
# of the account it runs as, which this account does not have.
Environment=TRANSPAREO_CONFIG_DIR=/etc/transpareo
EnvironmentFile=/etc/transpareo/signer.env
ExecStart=/usr/bin/transpareo signer serve --dir /etc/transpareo/signer --platform-key ${TRANSPAREO_PLATFORM_KEY} --host ${TRANSPAREO_SIGNER_HOST} --listen ${TRANSPAREO_SIGNER_LISTEN}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/transpareo/signer

[Install]
WantedBy=multi-user.target
